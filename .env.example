# Banco de dados (Neon PostgreSQL)
DATABASE_URL="postgresql://user:password@host/database?sslmode=require"

# NextAuth
AUTH_SECRET="generate-with-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"

# Resend (email transacional: recuperacao de senha)
RESEND_API_KEY="re_xxxxxxxxx"
RESEND_FROM_EMAIL="Mendoza IA <no-reply@seu-dominio.com>"

# Evolution API (WhatsApp)
WHATSAPP_API_URL="https://mendozaia-evolution-api.bohu4g.easypanel.host"
EVOLUTION_API_KEY="sua-apikey-aqui"

# Cron (opcional) - para follow-up automático
CRON_SECRET="seu-secret-para-cron"

# Upstash Redis - debounce distribuído de mensagens (obrigatório em produção)
UPSTASH_REDIS_REST_URL="https://xxx.upstash.io"
UPSTASH_REDIS_REST_TOKEN="sua-token"

# Upstash QStash - agendamento de processamento (obrigatório em produção)
QSTASH_TOKEN="sua-token"
QSTASH_CURRENT_SIGNING_KEY="sig_xxx"
QSTASH_NEXT_SIGNING_KEY="sig_xxx"

# URL base da aplicação (para QStash chamar o endpoint de processamento)
# Em Vercel: VERCEL_URL é preenchido automaticamente
# Local: use APP_URL ou NEXT_PUBLIC_APP_URL (ex: https://seu-dominio.ngrok.io)
# APP_URL="https://seu-app.vercel.app"

# Gemini (Google AI) - opcional se configurar em Configurações → Agente de IA
GEMINI_API_KEY="sua-chave-api-gemini"

# Meta (Instagram + Messenger)
META_APP_ID="seu-app-id"
META_APP_SECRET="seu-app-secret"
META_WEBHOOK_VERIFY_TOKEN="token-de-verificacao-do-webhook"
# Opcional (padrao: v23.0)
META_GRAPH_VERSION="v23.0"
